# ============================================================
# FINANCE NOTE - KONFIGURASI ENVIRONMENT
# Salin file ini menjadi `.env` lalu isi nilai-nilainya.
# ============================================================

# ------------------------------------------------------------
# 1. TELEGRAM BOT
# ------------------------------------------------------------
# Buat bot baru melalui @BotFather di Telegram lalu salin tokennya di sini.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# ID Telegram Anda (pisahkan koma jika lebih dari satu) untuk membatasi akses.
# Cek ID Telegram Anda via bot @userinfobot di Telegram.
# Contoh: 123456789
ALLOWED_TELEGRAM_USER_IDS="123456789"

# Otomatis simpan screenshot transaksi tanpa perlu menekan tombol konfirmasi (True/False)
AUTO_CONFIRM_SCREENSHOT=False

# ------------------------------------------------------------
# 2. GOOGLE SHEETS
# ------------------------------------------------------------
# Path ke berkas Service Account JSON dari Google Cloud Console
# Letakkan file json di folder credentials/service_account.json
GOOGLE_SERVICE_ACCOUNT_FILE="credentials/service_account.json"

# ID Spreadsheet Google Sheets Anda (dapat dilihat dari URL Google Sheets)
# URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"

# Nama tab/worksheet utama
GOOGLE_SHEET_TAB_TRANSAKSI="Transaksi"
GOOGLE_SHEET_TAB_KATEGORI="Kategori"
GOOGLE_SHEET_TAB_DASHBOARD="Dashboard"

# ------------------------------------------------------------
# 3. EMAIL LISTENER (LIVIN' BY MANDIRI)
# ------------------------------------------------------------
# Alamat email tempat menerima notifikasi Mandiri
EMAIL_IMAP_SERVER="imap.gmail.com"
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER="realwidisfadhil23@gmail.com"

# Password aplikasi email (Google App Password 16 karakter):
# Buat di https://myaccount.google.com/apppasswords
EMAIL_IMAP_PASSWORD="your_16_char_app_password"

# Interval pemeriksaan email baru dalam detik (default: 30 detik)
EMAIL_CHECK_INTERVAL_SECONDS=30

# Folder IMAP yang dipantau (default: INBOX)
EMAIL_IMAP_FOLDER="INBOX"

# Pengirim email notifikasi Mandiri (biasanya noreply@bankmandiri.co.id)
EMAIL_MANDIRI_SENDER="noreply@bankmandiri.co.id"

# ------------------------------------------------------------
# 4. OCR & VISION AI (GEMINI atau OLLAMA)
# ------------------------------------------------------------
# Pilih provider OCR: "gemini" atau "ollama"
OCR_PROVIDER="gemini"

# [Jika menggunakan Gemini]
# API Key gratis di https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# [Jika menggunakan Ollama Lokal]
# Model vision: llama3.2-vision, minicpm-v, atau llava
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2-vision"

# ------------------------------------------------------------
# 5. GENERAL & TESTING
# ------------------------------------------------------------
# Setel True untuk mencoba sistem tanpa API key asli (menggunakan mock data)
MOCK_MODE=False

# Database SQLite lokal untuk deduplikasi
DATABASE_PATH="data/finance.db"

# Zona Waktu
TIMEZONE="Asia/Jakarta"
